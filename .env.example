HOST=0.0.0.0 # Bind address; keep 0.0.0.0 for Railway and containers.
PORT=8000 # Local HTTP port; Railway supplies PORT automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/pydantic_ai # PostgreSQL URL; on Railway use ${{Postgres.DATABASE_URL}}.

MODEL_PROVIDER=openai # Supported values: openai, anthropic, google, or groq.
MODEL_NAME=gpt-4o-mini # Provider model name without its Pydantic AI prefix.

OPENAI_API_KEY= # Required when MODEL_PROVIDER=openai.
ANTHROPIC_API_KEY= # Required when MODEL_PROVIDER=anthropic.
GOOGLE_API_KEY= # Required when MODEL_PROVIDER=google.
GROQ_API_KEY= # Required when MODEL_PROVIDER=groq.

SYSTEM_PROMPT=You are a helpful AI assistant. # Instructions applied to every agent run.
REQUEST_TIMEOUT_SECONDS=60 # Maximum duration of a model request in seconds.
