HOST=0.0.0.0 # Optional: bind address; keep 0.0.0.0 for Railway and containers.
PORT=8000 # Optional: local HTTP port; Railway supplies PORT automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/pydantic_ai # PostgreSQL URL; on Railway use ${{Postgres.DATABASE_URL}}.
DB_POOL_MIN_SIZE=1 # Optional: minimum PostgreSQL connections kept open.
DB_POOL_MAX_SIZE=10 # Optional: maximum PostgreSQL connections per app instance.
DB_POOL_TIMEOUT=10 # Optional: seconds to wait for an available database connection.
APP_API_KEY= # Optional: Bearer token required by chat and conversation APIs when set.

MODEL_PROVIDER=openai # Optional: supported values are openai, anthropic, google, or groq.
MODEL_NAME=gpt-4o-mini # Optional: provider model name without its Pydantic AI prefix.

OPENAI_API_KEY= # Optional: required only when MODEL_PROVIDER=openai.
ANTHROPIC_API_KEY= # Optional: required only when MODEL_PROVIDER=anthropic.
GOOGLE_API_KEY= # Optional: required only when MODEL_PROVIDER=google.
GROQ_API_KEY= # Optional: required only when MODEL_PROVIDER=groq.

SYSTEM_PROMPT=You are a helpful AI assistant. # Optional: instructions applied to every agent run.
REQUEST_TIMEOUT_SECONDS=60 # Optional: maximum duration of a model request in seconds.
