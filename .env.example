# Network interface. Keep 0.0.0.0 for Railway/container deployments.
HOST=0.0.0.0
# Railway supplies PORT automatically; 8000 is the local default.
PORT=8000

# Provider: openai, anthropic, google, or groq.
MODEL_PROVIDER=openai
# Model name without the provider prefix.
MODEL_NAME=gpt-4o-mini
# Instruction applied to every agent run.
SYSTEM_PROMPT=You are a helpful AI assistant.
# Maximum time allowed for one model request, in seconds.
REQUEST_TIMEOUT_SECONDS=60

# Set only the key used by MODEL_PROVIDER. Never commit real secrets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

